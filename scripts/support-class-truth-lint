#!/usr/bin/env python3
"""Lint current support-class claims against the repo truth surface."""

from __future__ import annotations

import pathlib
import re
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
ALLOWED = {"Product", "Smoke", "Prototype", "Synthetic", "Design"}
EXPECTED_ROWS = {
    "`honey` kernel generic lane": "Product",
    "`honey` VR session": "Smoke",
    "Eye tracking": "Prototype",
    "Hand tracking / gestures": "Prototype",
    "BCI / BrainFlow hardware acquisition": "Design",
    "BCI synthetic pipeline": "Synthetic",
    "Mouth / voice input": "Design",
}
BIOMODAL_ROWS = {
    "Eye tracking",
    "Hand tracking / gestures",
    "BCI / BrainFlow hardware acquisition",
    "Mouth / voice input",
}


def read(relative: str) -> str:
    return (ROOT / relative).read_text(encoding="utf-8")


def parse_support_matrix() -> dict[str, tuple[str, str]]:
    rows: dict[str, tuple[str, str]] = {}
    for line in read("docs/support-matrix.md").splitlines():
        if not line.startswith("| "):
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if len(cells) < 3 or cells[0] in {"Target", "Surface", "Area", "Workflow Area", "Level"}:
            continue
        if set(cells[1]) <= {"-", " "}:
            continue
        if re.fullmatch(r"P[0-9]+", cells[0]):
            continue
        rows[cells[0]] = (cells[1], cells[2])
    return rows


def fail(message: str) -> None:
    print(f"support-class-truth-lint: {message}", file=sys.stderr)
    raise SystemExit(1)


def require(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def main() -> int:
    support_matrix = read("docs/support-matrix.md")
    readme = read("README.md")
    issue_template = read(".github/ISSUE_TEMPLATE/bug-report.yml")
    issue_config = read(".github/ISSUE_TEMPLATE/config.yml")
    rows = parse_support_matrix()

    for support_class in sorted(ALLOWED):
        require(
            f"- `{support_class}`:" in support_matrix,
            f"support matrix is missing `{support_class}` vocabulary",
        )

    require("`Proven`" not in support_matrix, "`Proven` remains in support matrix")
    require("Out of scope" not in {status for status, _notes in rows.values()},
            "support matrix contains non-normalized `Out of scope` status")

    for row, expected in EXPECTED_ROWS.items():
        require(row in rows, f"missing support row: {row}")
        actual, notes = rows[row]
        require(
            actual == expected,
            f"{row} must be `{expected}`, found `{actual}`",
        )
        if expected == "Synthetic":
            lowered = notes.lower()
            require("synthetic" in lowered, f"{row} must explicitly say synthetic")
            require("not hardware" in lowered, f"{row} must not imply hardware proof")

    for row, (support_class, notes) in rows.items():
        require(
            support_class in ALLOWED,
            f"{row} has unsupported support class `{support_class}`",
        )
        if row in BIOMODAL_ROWS:
            require(
                support_class not in {"Product", "Smoke"},
                f"{row} cannot be `{support_class}` without named-host product evidence",
            )
            require(
                re.search(r"no named-host|not yet named-host|no native product contract", notes, re.I),
                f"{row} must state the missing named-host/product proof boundary",
            )

    honey_vr_status, honey_vr_notes = rows["`honey` VR session"]
    require(honey_vr_status == "Smoke", "`honey` VR session must remain Smoke before P4")
    require("P3" in honey_vr_notes and "P4" in honey_vr_notes,
            "`honey` VR session must state P3/P4 boundary")
    require("black" in honey_vr_notes.lower(),
            "`honey` VR session must state current black-headset result")

    require("Prototype / Synthetic / Design" in readme,
            "README must expose biomodal prototype/synthetic/design split")
    for support_class in sorted(ALLOWED):
        require(
            f"- {support_class}" in issue_template or f"{support_class} /" in issue_config,
            f"issue templates must expose `{support_class}` support class",
        )

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

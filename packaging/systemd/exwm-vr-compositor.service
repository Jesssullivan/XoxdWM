[Unit]
Description=EXWM-VR Wayland Compositor
Documentation=https://github.com/Jesssullivan/XoxdWM
PartOf=exwm-vr.target

[Service]
Type=simple
Environment=EXWM_VR_COMPOSITOR_BACKEND=drm
Environment=EXWM_VR_WAYLAND_SOCKET=wayland-0
ExecStart=/usr/bin/ewwm-compositor --backend drm --wayland-socket wayland-0
Restart=on-failure
RestartSec=3
Environment=XDG_CURRENT_DESKTOP=EXWM-VR
Environment=XDG_SESSION_TYPE=wayland

[Install]
WantedBy=exwm-vr.target

[Unit]
Description=XoxdWM BrainFlow BCI Daemon
Documentation=https://github.com/Jesssullivan/XoxdWM
After=exwm-vr-compositor.service
ConditionPathExists=/dev/openbci
PartOf=xoxdwm.target exwm-vr.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/bin/true

[Install]
WantedBy=xoxdwm.target exwm-vr.target
Alias=xoxdwm-brainflow.service

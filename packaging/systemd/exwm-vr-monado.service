[Unit]
Description=EXWM-VR Monado OpenXR Runtime
Documentation=https://github.com/Jesssullivan/XoxdWM
After=exwm-vr-compositor.service
ConditionUser=!root
ConditionPathExists=/etc/xdg/openxr/1/active_runtime.json
Conflicts=monado-dev.service
PartOf=exwm-vr.target

[Service]
Type=simple
ExecStart=/usr/libexec/exwm-vr/monado-launch
Environment=XRT_COMPOSITOR_LOG=debug
Environment=XRT_PRINT_OPTIONS=on
Environment=XRT_NO_STDIN=TRUE
Environment=IPC_EXIT_ON_DISCONNECT=OFF
Environment=XR_RUNTIME_JSON=/etc/xdg/openxr/1/active_runtime.json
Environment=WAYLAND_DISPLAY=wayland-0
EnvironmentFile=-%h/.config/exwm-vr/monado.env
Restart=no

[Install]
WantedBy=exwm-vr.target
